{
  "name": "dsh-llm-reasoning-retry",
  "version": "0.1.2",
  "description": "Recovers from upstream reasoning-only completions in DeepSeek Harness: when a streaming response ends with HTTP 200 and a stop reason but contains only thinking blocks (no text, no tool_use), re-issue the identical request once before the adapter records an empty turn; fail loudly if the retry is empty too.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./classify": "./lib/classify.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "reasoning",
    "retry",
    "empty-response"
  ],
  "license": "MIT",
  "author": "MacilyDots",
  "scripts": {
    "test": "node test/test-retry.mjs && node test/test-freeze.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MacilyDots/dsh-llm-reasoning-retry.git"
  },
  "homepage": "https://github.com/MacilyDots/dsh-llm-reasoning-retry#readme",
  "bugs": {
    "url": "https://github.com/MacilyDots/dsh-llm-reasoning-retry/issues"
  }
}